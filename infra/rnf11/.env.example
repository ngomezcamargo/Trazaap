# Variables exclusivas del laboratorio RNF11 efimero. No reutilizar en QA.
RNF11_POSTGRES_PASSWORD=change_ephemeral_postgres_password
RNF11_KEYCLOAK_ADMIN_PASSWORD=change_ephemeral_admin_password
RNF11_TEMP_ADMIN_PASSWORD=change_ephemeral_user_password
RNF11_TEMP_MANAGER_PASSWORD=change_ephemeral_user_password
RNF11_TEMP_OPERATOR_PASSWORD=change_ephemeral_user_password

# Controles opcionales para validaciones tecnicas automatizadas.
RUN_DB_TESTS=false
RUN_EPCIS_SCHEMA_TESTS=false
RNF11_API_URL=http://127.0.0.1:44044/api
RNF11_OAUTH_USERNAME=temporary-user
RNF11_OAUTH_PASSWORD=change_ephemeral_user_password
RNF11_OAUTH_SCOPE=openid profile trazaap.read
RNF11_EXPECT_PROFILE_STATUS=200
RNF11_EXPECT_USERS_STATUS=403
RNF11_EXPECT_EPCIS_STATUS=403
RNF11_DELAY_BEFORE_PROFILE_MS=0
