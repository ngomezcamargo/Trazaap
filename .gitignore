frontend/.env.*.local

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Next.js
frontend/.next/
frontend/out/
frontend/.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/
frontend/logs/

# Runtime/cache files
.DS_Store
Thumbs.db
*.pid
*.seed
*.pid.lock
.cache/
coverage/

# PostgreSQL/local data
postgres-data/
pgdata/
*.dump
*.sql.dump

# Hyperledger Fabric generated artifacts
fabric/bin/
fabric/fabric-ca/
fabric/organizations/
fabric/channel-artifacts/
fabric/chaincode-packages/
