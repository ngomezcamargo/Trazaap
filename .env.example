# =========================
# Trazaap - Backend
# Copy to backend/.env
# =========================
NODE_ENV=development
PORT=4000
API_PREFIX=/api
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=8h
# Valor ficticio de desarrollo; configurar el codigo empresarial antes de desplegar.
FABRICA_CODIGO=PRUEBA
# Umbral técnico de desarrollo, no constituye límite regulatorio ni empresarial.
DIAS_ALERTA_VENCIMIENTO=30

# Credenciales exclusivas del seed. Configurar secretos reales fuera del repositorio.
# Administrador y operario conservan su valor historico de desarrollo si se omiten.
SEED_ADMIN_PASSWORD=
SEED_GERENTE_PASSWORD=
SEED_OPERARIO_PASSWORD=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trazaap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

FABRIC_ENABLED=true
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=trazabilidad-channel
FABRIC_CHAINCODE_NAME=traceability
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.trazaap.local
FABRIC_TLS_CERT_PATH=../fabric/organizations/peerOrganizations/org1.trazaap.local/peers/peer0.org1.trazaap.local/tls/ca.crt
FABRIC_CERT_PATH=../fabric/organizations/peerOrganizations/org1.trazaap.local/users/Admin@org1.trazaap.local/msp/signcerts/cert.pem
FABRIC_KEY_PATH=../fabric/organizations/peerOrganizations/org1.trazaap.local/users/Admin@org1.trazaap.local/msp/keystore/priv_sk

# Activalo junto con el perfil documents de Docker Compose para RF17.
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Generate local values and keep them outside version control.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DOCUMENTS_BUCKET=trazaap-documentos
MINIO_MAX_UPLOAD_BYTES=10485760

EPCIS_ENABLED=false
EPCIS_MAX_PAYLOAD_BYTES=1048576
EPCIS_SCHEMA_PATH=
EPCIS_CONTEXT_URL=https://ref.gs1.org/standards/epcis/epcis-context.jsonld
EPCIS_TIME_ZONE_OFFSET=-05:00

# =========================
# Trazaap - Frontend
# Copy to frontend/.env.local
# =========================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
