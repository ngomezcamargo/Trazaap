# =========================
# Trazaap - Backend
# Copy to backend/.env
# =========================
NODE_ENV=development
PORT=4000
API_PREFIX=/api
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=8h

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trazaap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =========================
# Trazaap - Frontend
# Copy to frontend/.env.local
# =========================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
