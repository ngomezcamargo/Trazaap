# =========================
# Trazaap - Backend
# Copy to backend/.env
# =========================
NODE_ENV=development
PORT=4000
API_PREFIX=/api
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=8h
AUTH_LEGACY_JWT_ENABLED=true
# Valor ficticio de desarrollo; configurar el codigo empresarial antes de desplegar.
FABRICA_CODIGO=PRUEBA

# OAuth 2.0 / OpenID Connect (Authorization Server estandar on-premise)
OAUTH_ENABLED=false
OAUTH_ISSUER=https://authorization.example/realms/trazaap
OAUTH_AUDIENCE=trazaap-api
OAUTH_JWKS_URI=https://authorization.example/realms/trazaap/protocol/openid-connect/certs
OAUTH_ALLOWED_ALGORITHMS=RS256
OAUTH_AUTHORIZATION_URL=https://authorization.example/realms/trazaap/protocol/openid-connect/auth
OAUTH_TOKEN_URL=https://authorization.example/realms/trazaap/protocol/openid-connect/token
OAUTH_REVOCATION_URL=https://authorization.example/realms/trazaap/protocol/openid-connect/revoke
OAUTH_CLIENT_ID=trazaap-web
OAUTH_CLIENT_SECRET=change_only_for_confidential_client
OAUTH_REDIRECT_URI=https://trazaap.example/oauth/callback
OAUTH_SCOPES=openid profile trazaap.read trazaap.operate
OAUTH_SECURE_COOKIES=true
OAUTH_MAX_ACCESS_TOKEN_SECONDS=900

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trazaap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

FABRIC_ENABLED=true
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=trazabilidad-channel
FABRIC_CHAINCODE_NAME=traceability
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.trazaap.local
FABRIC_TLS_CERT_PATH=../fabric/organizations/peerOrganizations/org1.trazaap.local/peers/peer0.org1.trazaap.local/tls/ca.crt
FABRIC_CERT_PATH=../fabric/organizations/peerOrganizations/org1.trazaap.local/users/Admin@org1.trazaap.local/msp/signcerts/cert.pem
FABRIC_KEY_PATH=../fabric/organizations/peerOrganizations/org1.trazaap.local/users/Admin@org1.trazaap.local/msp/keystore/priv_sk

MINIO_ENABLED=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change_this_minio_access_key
MINIO_SECRET_KEY=change_this_minio_secret_key
MINIO_DOCUMENTS_BUCKET=trazaap-documentos
MINIO_MAX_UPLOAD_BYTES=10485760

EPCIS_ENABLED=false
EPCIS_MAX_PAYLOAD_BYTES=1048576
EPCIS_SCHEMA_PATH=
EPCIS_CONTEXT_URL=https://ref.gs1.org/standards/epcis/epcis-context.jsonld
EPCIS_TIME_ZONE_OFFSET=-05:00

# =========================
# Trazaap - Frontend
# Copy to frontend/.env.local
# =========================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_AUTH_MODE=legacy
NEXT_PUBLIC_OAUTH_ISSUER=https://authorization.example/realms/trazaap
NEXT_PUBLIC_OAUTH_CLIENT_ID=trazaap-web
NEXT_PUBLIC_OAUTH_REDIRECT_URI=https://trazaap.example/oauth/callback
NEXT_PUBLIC_OAUTH_SCOPE=openid profile trazaap.read trazaap.operate
